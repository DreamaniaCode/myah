# URL de connexion PostgreSQL Coolify
# Si PostgreSQL est sur le même réseau Coolify, utilisez l'Internal Database URL:
# postgresql://<user>:<password>@<internal_service_name>:5432/<database>?schema=public
DATABASE_URL="postgresql://postgres:password@postgresql:5432/myah?schema=public"

# Clé secrète robuste pour l'authentification Admin
JWT_SECRET="remplacer_par_une_cle_secrete_aleatoire_de_production"

# Cloudinary (optionnel - si vous utilisez l'upload d'images via Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# TinyMCE (optionnel - pour l'éditeur d'articles de blog)
NEXT_PUBLIC_TINYMCE_API_KEY=""

# Environnement et Port
NODE_ENV="production"
PORT=3000
